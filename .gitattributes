# Source, scripts and workflows check out with LF on every system, Windows included
# (core.autocrlf would otherwise give CRLF, and the tools and tests read these files line
# by line).
*.rs     text eol=lf
*.toml   text eol=lf
*.lock   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.sh     text eol=lf
*.ps1    text eol=lf
*.nsi    text eol=lf
*.plist  text eol=lf
*.in     text eol=lf
*.slint  text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.html   text eol=lf
*.svg    text eol=lf

# The WiX source keeps its bytes as committed (CRLF).
*.wxs -text

